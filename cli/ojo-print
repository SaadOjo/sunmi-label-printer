#!/usr/bin/env python3
"""
ojo-print: terminal/agent-friendly SUNMI/raw printer CLI.

Transport: raw TCP/AppSocket/JetDirect (port 9100 by default)
Protocols: ESC/POS for receipts, TSPL for labels, raw passthrough for full control.
"""

from __future__ import annotations

import argparse
import base64
import binascii
import ipaddress
import json
import os
import socket
import sys
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Tuple

ESC = b"\x1b"
GS = b"\x1d"
DLE = b"\x10"
EOT = b"\x04"
LF = b"\x0a"

DEFAULT_PORT = 9100
DEFAULT_TIMEOUT = 3.0


@dataclass
class Result:
    ok: bool
    message: str = ""
    bytes_sent: int = 0
    protocol: str = "raw"
    transport: str = "tcp"
    host: str = ""
    port: int = DEFAULT_PORT
    extra: Optional[Dict[str, Any]] = None

    def to_dict(self) -> Dict[str, Any]:
        data = {
            "ok": self.ok,
            "message": self.message,
            "bytesSent": self.bytes_sent,
            "protocol": self.protocol,
            "transport": self.transport,
            "host": self.host,
            "port": self.port,
        }
        if self.extra:
            data.update(self.extra)
        return data


def print_json(data: Any) -> None:
    print(json.dumps(data, indent=2, sort_keys=True))


def fail(message: str, code: int = 1, **extra: Any) -> None:
    payload = {"ok": False, "message": message}
    payload.update(extra)
    print_json(payload)
    raise SystemExit(code)


def read_json_arg(value: str) -> Dict[str, Any]:
    if value == "-":
        return json.load(sys.stdin)
    with open(value, "r", encoding="utf-8") as f:
        return json.load(f)


def clean_text(value: Any, fallback: str = "") -> str:
    if value is None:
        return fallback
    return str(value).replace("\r", " ").replace("\n", " ")


def money(value: float, currency: str = "$") -> str:
    return f"{currency}{value:.2f}"


def send_tcp(host: str, port: int, data: bytes, timeout: float = DEFAULT_TIMEOUT, read_bytes: int = 0) -> Tuple[int, bytes]:
    if not data and read_bytes <= 0:
        return 0, b""
    with socket.create_connection((host, port), timeout=timeout) as sock:
        sock.settimeout(timeout)
        sent = 0
        if data:
            sock.sendall(data)
            sent = len(data)
        response = b""
        if read_bytes > 0:
            try:
                response = sock.recv(read_bytes)
            except socket.timeout:
                response = b""
        return sent, response


def escpos_init() -> bytes:
    return ESC + b"@"


def escpos_align(name: str) -> bytes:
    mapping = {"left": 0, "center": 1, "right": 2}
    return ESC + b"a" + bytes([mapping.get(name, 0)])


def escpos_bold(enabled: bool) -> bytes:
    return ESC + b"E" + bytes([1 if enabled else 0])


def escpos_size(width: int = 1, height: int = 1) -> bytes:
    width = max(1, min(8, int(width)))
    height = max(1, min(8, int(height)))
    n = ((height - 1) << 4) | (width - 1)
    return GS + b"!" + bytes([n])


def escpos_density(density: int) -> bytes:
    # SUNMI SDK exposes 70..130. ESC/POS has no single universal density command;
    # this GS ( E vendor command is not guaranteed. Keep as raw best-effort off by default.
    return b""


def escpos_cut(partial: bool = True) -> bytes:
    return GS + b"V" + bytes([66 if partial else 65, 0])


def escpos_cash_drawer() -> bytes:
    return ESC + b"p" + b"\x00\x40\xf0"


def escpos_qr(text: str, module_size: int = 6, ec: int = 49) -> bytes:
    payload = text.encode("utf-8")
    cn = b"\x31"
    out = bytearray()
    out += GS + b"(k" + b"\x03\x00" + cn + b"C" + bytes([max(1, min(16, module_size))])
    out += GS + b"(k" + b"\x03\x00" + cn + b"E" + bytes([ec])
    length = len(payload) + 3
    pL = length & 0xFF
    pH = (length >> 8) & 0xFF
    out += GS + b"(k" + bytes([pL, pH]) + cn + b"P0" + payload
    out += GS + b"(k" + b"\x03\x00" + cn + b"Q0"
    return bytes(out)


def escpos_barcode_code128(text: str, height: int = 70, module_width: int = 2, hri: int = 2) -> bytes:
    data = text.encode("ascii", "ignore")
    if not data:
        return b""
    # CODE128 form: GS k 73 n {B data. Some printers also support type 73 directly.
    body = b"{B" + data
    return (
        GS + b"h" + bytes([max(1, min(255, height))])
        + GS + b"w" + bytes([max(2, min(6, module_width))])
        + GS + b"H" + bytes([hri])
        + GS + b"k" + b"\x49" + bytes([len(body)]) + body
    )


def fit_columns(left: str, right: str, columns: int) -> str:
    columns = max(24, columns)
    right = clean_text(right)
    left = clean_text(left)
    if len(right) >= columns:
        return right[:columns]
    left_width = columns - len(right)
    if len(left) > left_width:
        left = left[: max(0, left_width - 1)] + "…"
    return left.ljust(left_width) + right


def wrap_text(text: str, width: int) -> List[str]:
    text = clean_text(text)
    words = text.split()
    if not words:
        return [""]
    lines: List[str] = []
    current = ""
    for word in words:
        if not current:
            current = word
        elif len(current) + 1 + len(word) <= width:
            current += " " + word
        else:
            lines.append(current)
            current = word
    if current:
        lines.append(current)
    return lines


def center(text: str, columns: int) -> str:
    text = clean_text(text)
    if len(text) > columns:
        text = text[:columns]
    return text.center(columns)


def build_receipt(job: Dict[str, Any]) -> bytes:
    paper = str(job.get("paper", "80"))
    columns = int(job.get("columns") or (32 if paper.startswith("58") else 48))
    currency = str(job.get("currency", "$"))
    store = clean_text(job.get("storeName", "OJO Store"), "OJO Store")
    address = job.get("storeAddress", "")
    phone = clean_text(job.get("storePhone", ""))
    order_no = clean_text(job.get("orderNumber", job.get("order", "-")), "-")
    cashier = clean_text(job.get("cashierName", job.get("cashier", "-")), "-")
    tax_rate = float(job.get("taxRate", 0.0))
    items = job.get("items") or []
    footer = clean_text(job.get("footerText", job.get("footer", "Thank you")))
    barcode = clean_text(job.get("barcode", job.get("barcodeValue", "")))
    qr = clean_text(job.get("qr", job.get("qrValue", "")))
    include_logo_text = bool(job.get("logoText", True))
    cut = bool(job.get("cut", True))
    cash_drawer = bool(job.get("cashDrawer", False))

    out = bytearray()
    out += escpos_init()
    out += escpos_align("center")
    if include_logo_text:
        out += escpos_bold(True) + escpos_size(2, 2)
        out += (store + "\n").encode("utf-8")
        out += escpos_size(1, 1) + escpos_bold(False)
    else:
        out += escpos_bold(True)
        out += (store + "\n").encode("utf-8")
        out += escpos_bold(False)

    if address:
        for line in str(address).replace("\r", "").split("\n"):
            for wrapped in wrap_text(line, columns):
                out += (center(wrapped, columns) + "\n").encode("utf-8")
    if phone:
        out += (center(phone, columns) + "\n").encode("utf-8")

    out += escpos_align("left")
    out += ("-" * columns + "\n").encode("utf-8")
    out += f"Order: {order_no}\n".encode("utf-8")
    out += f"Cashier: {cashier}\n".encode("utf-8")
    out += time.strftime("Date: %Y-%m-%d %H:%M\n").encode("utf-8")
    out += ("-" * columns + "\n").encode("utf-8")

    subtotal = 0.0
    for item in items:
        name = clean_text(item.get("name", "Item"), "Item")
        qty = int(item.get("quantity", item.get("qty", 1)))
        unit = float(item.get("unitPrice", item.get("price", 0.0)))
        total = qty * unit
        subtotal += total
        out += (fit_columns(name, money(total, currency), columns) + "\n").encode("utf-8")
        detail = f"  {qty} x {money(unit, currency)}"
        out += (detail[:columns] + "\n").encode("utf-8")

    tax = subtotal * tax_rate
    total = subtotal + tax
    out += ("-" * columns + "\n").encode("utf-8")
    out += (fit_columns("Subtotal", money(subtotal, currency), columns) + "\n").encode("utf-8")
    if tax_rate:
        out += (fit_columns("Tax", money(tax, currency), columns) + "\n").encode("utf-8")
    out += escpos_bold(True)
    out += (fit_columns("TOTAL", money(total, currency), columns) + "\n").encode("utf-8")
    out += escpos_bold(False)

    if barcode:
        out += b"\n" + escpos_align("center") + escpos_barcode_code128(barcode) + b"\n"
    if qr:
        out += b"\n" + escpos_align("center") + escpos_qr(qr, module_size=int(job.get("qrSize", 6))) + b"\n"
    if footer:
        out += escpos_align("center")
        for line in wrap_text(footer, columns):
            out += (center(line, columns) + "\n").encode("utf-8")
    out += b"\n\n\n"
    if cash_drawer:
        out += escpos_cash_drawer()
    if cut:
        out += escpos_cut(partial=True)
    return bytes(out)


def tspl_escape(value: Any, fallback: str = "") -> str:
    text = clean_text(value, fallback)
    return text.replace('\\', '/').replace('"', "'")


def build_label(job: Dict[str, Any]) -> bytes:
    width = float(job.get("widthMM", job.get("width", 50)))
    height = float(job.get("heightMM", job.get("height", 20)))
    gap = float(job.get("gapMM", job.get("gap", 3)))
    speed = int(job.get("speed", 3))
    density = int(job.get("density", 12))
    copies = int(job.get("copies", 1))
    title = tspl_escape(job.get("title", job.get("brand", "OJO")))
    subtitle = tspl_escape(job.get("subtitle", job.get("productName", "Sample Item")))
    price = tspl_escape(job.get("price", "$9.99"))
    barcode = tspl_escape(job.get("barcode", job.get("sku", "SKU001234")))
    qr = tspl_escape(job.get("qr", job.get("qrValue", barcode)))
    include_qr = bool(job.get("includeQR", True))

    wd = max(160, round(width * 8))
    hd = max(80, round(height * 8))
    right_x = max(220, wd - 104)
    barcode_y = max(70, hd - 82)
    barcode_h = min(46, max(28, hd - barcode_y - 34))
    bottom_y = max(70, hd - 34)

    lines = [
        f"SIZE {width:g} mm,{height:g} mm",
        f"GAP {gap:g} mm,0",
        f"SPEED {speed}",
        f"DENSITY {density}",
        "DIRECTION 1",
        "REFERENCE 0,0",
        "OFFSET 0 mm",
    ]
    if job.get("home", False):
        lines.append("HOME")
    lines.extend([
        "CLS",
        f"BAR 8,8,{max(10, wd - 16)},3",
        f"BAR 8,{max(12, hd - 10)},{max(10, wd - 16)},3",
        f'TEXT 18,18,"3",0,1,1,"{title[:24]}"',
        f'TEXT 18,52,"1",0,1,1,"{subtitle[:32]}"',
        f'BARCODE 18,{barcode_y},"128",{barcode_h},0,0,2,2,"{barcode[:24]}"',
        f'TEXT 18,{bottom_y},"1",0,1,1,"{barcode[:24]}"',
        f'TEXT {right_x},22,"3",0,1,1,"{price[:12]}"',
    ])
    if include_qr and wd >= 360 and hd >= 150:
        lines.append(f'QRCODE {right_x},{max(66, hd - 88)},L,3,A,0,"{qr[:64]}"')
    lines.append(f"PRINT {max(1, copies)},1")
    return ("\r\n".join(lines) + "\r\n").encode("utf-8")


def build_calibrate_label(args: argparse.Namespace) -> bytes:
    return (
        f"SIZE {args.width:g} mm,{args.height:g} mm\r\n"
        f"GAP {args.gap:g} mm,0\r\n"
        "GAPDECTECT\r\n"
        "HOME\r\n"
    ).encode("utf-8")


def parse_pbm(path: str) -> Tuple[int, int, List[int]]:
    data = Path(path).read_bytes()
    tokens: List[bytes] = []
    i = 0
    while len(tokens) < 3 and i < len(data):
        while i < len(data) and data[i] in b" \t\r\n":
            i += 1
        if i < len(data) and data[i] == ord("#"):
            while i < len(data) and data[i] not in b"\r\n":
                i += 1
            continue
        start = i
        while i < len(data) and data[i] not in b" \t\r\n":
            i += 1
        if start < i:
            tokens.append(data[start:i])
    if len(tokens) < 3:
        raise ValueError("Invalid PBM header")
    magic, w_s, h_s = tokens
    width, height = int(w_s), int(h_s)
    pixels: List[int] = []
    if magic == b"P1":
        rest = data[i:].decode("ascii", "ignore")
        vals = [v for v in rest.replace("\n", " ").split(" ") if v and not v.startswith("#")]
        pixels = [1 if v == "1" else 0 for v in vals[: width * height]]
    elif magic == b"P4":
        while i < len(data) and data[i] in b" \t\r\n":
            i += 1
        row_bytes = (width + 7) // 8
        raw = data[i : i + row_bytes * height]
        for y in range(height):
            row = raw[y * row_bytes : (y + 1) * row_bytes]
            for x in range(width):
                pixels.append(1 if row[x // 8] & (0x80 >> (x % 8)) else 0)
    else:
        raise ValueError("Only PBM P1/P4 images are supported without dependencies")
    if len(pixels) < width * height:
        raise ValueError("PBM image data is incomplete")
    return width, height, pixels


def escpos_raster_from_pbm(path: str, max_width: int) -> bytes:
    width, height, pixels = parse_pbm(path)
    if width > max_width:
        raise ValueError(f"PBM width {width} exceeds max printable width {max_width}; resize before printing")
    row_bytes = (width + 7) // 8
    raster = bytearray(row_bytes * height)
    for y in range(height):
        for x in range(width):
            if pixels[y * width + x]:
                raster[y * row_bytes + x // 8] |= 0x80 >> (x % 8)
    xL, xH = row_bytes & 0xFF, (row_bytes >> 8) & 0xFF
    yL, yH = height & 0xFF, (height >> 8) & 0xFF
    return escpos_init() + escpos_align("center") + GS + b"v0" + b"\x00" + bytes([xL, xH, yL, yH]) + bytes(raster) + b"\n"


def command_receipt(args: argparse.Namespace) -> None:
    job = read_json_arg(args.json) if args.json else sample_receipt_job()
    data = build_receipt(job)
    if args.preview:
        sys.stdout.buffer.write(data)
        return
    sent, _ = send_tcp(args.ip, args.port, data, args.timeout)
    print_json(Result(True, "receipt sent", sent, "escpos", "tcp", args.ip, args.port).to_dict())


