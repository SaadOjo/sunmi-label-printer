    return {
        "widthMM": 50,
        "heightMM": 20,
        "gapMM": 3,
        "speed": 3,
        "density": 12,
        "title": "OJO",
        "subtitle": "Thermal Label Roll",
        "price": "$8.99",
        "barcode": "SKU001234",
        "qr": "https://ojo.example/SKU001234",
    }


def add_network_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--ip", required=True, help="printer IP/host")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT, help="raw TCP port, usually 9100")
    parser.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="socket timeout seconds")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="ojo-print", description="Terminal/agent printer CLI for SUNMI receipt and label printers")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("doctor", help="show environment and optionally test TCP connectivity")
    p.add_argument("--ip", help="optional printer IP/host")
    p.add_argument("--port", type=int, default=DEFAULT_PORT)
    p.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    p.set_defaults(func=command_doctor)

    p = sub.add_parser("discover", help="scan a subnet for open raw printer TCP ports")
    p.add_argument("--subnet", required=True, help="CIDR subnet, e.g. 192.168.0.0/24")
    p.add_argument("--port", type=int, default=DEFAULT_PORT)
    p.add_argument("--timeout", type=float, default=0.35)
    p.add_argument("--workers", type=int, default=64)
    p.set_defaults(func=command_discover)

    p = sub.add_parser("receipt", help="print an ESC/POS receipt from JSON or sample data")
    add_network_args(p)
    p.add_argument("--json", help="receipt JSON file, or - for stdin")
    p.add_argument("--preview", action="store_true", help="write generated bytes to stdout instead of printing")
    p.set_defaults(func=command_receipt)

    p = sub.add_parser("label", help="print a TSPL label from JSON or sample data")
    add_network_args(p)
    p.add_argument("--json", help="label JSON file, or - for stdin")
    p.add_argument("--preview", action="store_true", help="write generated TSPL to stdout instead of printing")
    p.set_defaults(func=command_label)

    p = sub.add_parser("calibrate-label", help="send TSPL gap calibration/alignment")
    add_network_args(p)
    p.add_argument("--width", type=float, default=50)
    p.add_argument("--height", type=float, default=20)
    p.add_argument("--gap", type=float, default=3)
    p.add_argument("--preview", action="store_true")
    p.set_defaults(func=command_calibrate_label)

    p = sub.add_parser("raw", help="send raw bytes/text/hex/base64")
    add_network_args(p)
    p.add_argument("--protocol", default="raw", help="metadata only: raw, escpos, tspl")
    p.add_argument("--file", help="binary/raw command file")
    p.add_argument("--text", help="UTF-8 text/commands to send")
    p.add_argument("--hex", help="hex bytes to send")
    p.add_argument("--base64", help="base64 bytes to send")
    p.add_argument("--read", type=int, default=0, help="read up to N response bytes")
    p.set_defaults(func=command_raw)

    p = sub.add_parser("image", help="print a monochrome PBM image using ESC/POS raster image")
    add_network_args(p)
    p.add_argument("--pbm", required=True, help="PBM P1/P4 image path")
    p.add_argument("--max-width", type=int, default=576, help="max printable image width in dots")
    p.add_argument("--cut", action="store_true")
    p.set_defaults(func=command_image)

    p = sub.add_parser("status", help="try ESC/POS real-time status queries")
    add_network_args(p)
    p.set_defaults(func=command_status)

    p = sub.add_parser("media", help="explain media-size detection limitations")
    p.set_defaults(func=command_media)

    p = sub.add_parser("width-test", help="print receipt width/columns test")
    add_network_args(p)
    p.add_argument("--paper", default="80")
    p.add_argument("--columns", type=int, default=48)
    p.set_defaults(func=command_width_test)

    p = sub.add_parser("job", help="run a machine-readable job JSON")
    p.add_argument("--json", required=True, help="job JSON file, or - for stdin")
    p.add_argument("--ip", help="override transport.host")
    p.add_argument("--port", type=int, help="override transport.port")
    p.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    p.add_argument("--preview", action="store_true")
    p.set_defaults(func=command_job)

    return parser


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        args.func(args)
        return 0
    except BrokenPipeError:
        return 0
    except SystemExit:
        raise
    except Exception as exc:
        fail(str(exc), code=2)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
