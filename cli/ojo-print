def command_raw(args: argparse.Namespace) -> None:
    chunks: List[bytes] = []
    if args.file:
        chunks.append(Path(args.file).read_bytes())
    if args.text is not None:
        chunks.append(args.text.encode("utf-8"))
    if args.hex is not None:
        chunks.append(binascii.unhexlify(args.hex.replace(" ", "")))
    if args.base64 is not None:
        chunks.append(base64.b64decode(args.base64))
    data = b"".join(chunks)
    if not data:
        fail("no raw data supplied; use --file, --text, --hex, or --base64")
    sent, response = send_tcp(args.ip, args.port, data, args.timeout, read_bytes=args.read)
    print_json(Result(True, "raw data sent", sent, args.protocol, "tcp", args.ip, args.port, extra={"responseHex": response.hex()}).to_dict())


def command_image(args: argparse.Namespace) -> None:
    data = escpos_raster_from_pbm(args.pbm, args.max_width)
    if args.cut:
        data += b"\n\n" + escpos_cut(partial=True)
    sent, _ = send_tcp(args.ip, args.port, data, args.timeout)
    print_json(Result(True, "PBM image sent", sent, "escpos-raster", "tcp", args.ip, args.port).to_dict())


def decode_escpos_status(n: int, value: Optional[int]) -> Dict[str, Any]:
    if value is None:
        return {"n": n, "received": False}
    info: Dict[str, Any] = {"n": n, "received": True, "byte": value, "hex": f"{value:02x}"}
    if n == 1:
        info.update({"online": not bool(value & 0x08), "coverOpen": bool(value & 0x20)})
    elif n == 2:
        info.update({"drawerPinHigh": bool(value & 0x04), "offline": bool(value & 0x08)})
    elif n == 3:
        info.update({"paperNearEnd": bool(value & 0x0C), "paperEnd": bool(value & 0x60)})
    elif n == 4:
        info.update({"recoverableError": bool(value & 0x0C), "cutterError": bool(value & 0x08), "unrecoverableError": bool(value & 0x20)})
    return info


def command_status(args: argparse.Namespace) -> None:
    statuses = []
    for n in [1, 2, 3, 4]:
        try:
            _, response = send_tcp(args.ip, args.port, DLE + EOT + bytes([n]), args.timeout, read_bytes=1)
            value = response[0] if response else None
            statuses.append(decode_escpos_status(n, value))
        except Exception as exc:
            statuses.append({"n": n, "received": False, "error": str(exc)})
    ok = any(s.get("received") for s in statuses)
    print_json({"ok": ok, "protocol": "escpos-status", "host": args.ip, "port": args.port, "statuses": statuses})


def command_discover(args: argparse.Namespace) -> None:
    network = ipaddress.ip_network(args.subnet, strict=False)
    hosts = [str(h) for h in network.hosts()]
    found: List[Dict[str, Any]] = []

    def probe(host: str) -> Optional[Dict[str, Any]]:
        try:
            with socket.create_connection((host, args.port), timeout=args.timeout):
                return {"host": host, "port": args.port, "open": True}
        except Exception:
            return None

    with ThreadPoolExecutor(max_workers=args.workers) as pool:
        futures = [pool.submit(probe, host) for host in hosts]
        for future in as_completed(futures):
            item = future.result()
            if item:
                found.append(item)
    found.sort(key=lambda x: ipaddress.ip_address(x["host"]))
    print_json({"ok": True, "subnet": args.subnet, "port": args.port, "printers": found})


def command_job(args: argparse.Namespace) -> None:
    spec = read_json_arg(args.json)
    transport = spec.get("transport", {})
    host = args.ip or transport.get("host") or spec.get("ip")
    if not host:
        fail("job requires transport.host or --ip")
    port = int(args.port or transport.get("port") or DEFAULT_PORT)
    mode = spec.get("mode", "receipt")
    job = spec.get("job", spec)
    if mode == "receipt":
        data = build_receipt(job)
        protocol = "escpos"
    elif mode == "label":
        data = build_label(job)
        protocol = "tspl"
    elif mode == "raw":
        raw = job.get("base64")
        if raw:
            data = base64.b64decode(raw)
        elif "hex" in job:
            data = binascii.unhexlify(str(job["hex"]).replace(" ", ""))
        elif "text" in job:
            data = str(job["text"]).encode("utf-8")
        else:
            fail("raw job requires base64, hex, or text")
        protocol = spec.get("protocol", "raw")
    else:
        fail(f"unknown mode: {mode}")
    if args.preview:
        sys.stdout.buffer.write(data)
        return
    sent, _ = send_tcp(host, port, data, args.timeout)
    print_json(Result(True, "job sent", sent, protocol, "tcp", host, port).to_dict())


def command_media(args: argparse.Namespace) -> None:
    message = (
        "There is no reliable standard ESC/POS or TSPL query for the loaded receipt roll width "
        "or label size. Receipt paper width is usually inferred from printer model/head width; "
        "label width is not sensed, and label height/gap can be calibrated by the gap/black-mark "
        "sensor but generally is not returned over raw TCP. Store media size in your app config and "
        "use calibrate-label after changing label rolls."
    )
    print_json({
        "ok": True,
        "canQueryInstalledMediaSize": False,
        "message": message,
        "receiptRecommendation": "Use paper=80/columns=48 for 80mm or paper=58/columns=32 for 58mm; print a width-test if unsure.",
        "labelRecommendation": "Know widthMM/heightMM/gapMM from the roll, send SIZE/GAP in each TSPL job, run calibrate-label after loading media.",
        "statusAvailable": "ESC/POS DLE EOT can often return online/paper/error status, but not loaded paper size.",
    })


def command_width_test(args: argparse.Namespace) -> None:
    columns = int(args.columns)
    job = {
        "paper": args.paper,
        "columns": columns,
        "storeName": "WIDTH TEST",
        "storeAddress": f"If this line clips, reduce columns/width. Columns={columns}",
        "items": [
            {"name": "Left edge -> right edge", "quantity": 1, "unitPrice": 0},
        ],
        "footer": "0123456789" * ((columns // 10) + 1),
        "cut": True,
        "logoText": False,
    }
    data = build_receipt(job)
    sent, _ = send_tcp(args.ip, args.port, data, args.timeout)
    print_json(Result(True, "width test sent", sent, "escpos", "tcp", args.ip, args.port).to_dict())


def command_doctor(args: argparse.Namespace) -> None:
    checks: Dict[str, Any] = {
        "python": sys.version.split()[0],
        "executable": sys.executable,
        "cwd": os.getcwd(),
    }
    if args.ip:
        try:
            with socket.create_connection((args.ip, args.port), timeout=args.timeout):
                checks["tcp"] = {"ok": True, "host": args.ip, "port": args.port}
        except Exception as exc:
            checks["tcp"] = {"ok": False, "host": args.ip, "port": args.port, "error": str(exc)}
    print_json({"ok": True, "checks": checks})


